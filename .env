# ─── LLM Configuration ───────────────────────────────────────────────────────
# Backend: "ollama" (default) or "openai" (llama-server, vLLM, LM Studio)
LLM_BACKEND=ollama

# Base URL for chat models
# For Ollama: http://localhost:11434
# For llama-server: http://localhost:8080
LLM_BASE_URL=http://localhost:11434

# Separate base URL for embeddings (always uses Ollama API)
EMBED_BASE_URL=http://localhost:11434

# Heavy model — conversations, reflections, snap resolution
CHAT_MODEL=huihui_ai/gemma-4-abliterated:e4b

# Light model — planning, decomposition, goals, self-descriptions
# Set to a smaller/faster model to free GPU for concurrent heavy calls
# Examples: qwen2.5:3b, phi3:3.8b, gemma2:2b
# Default: same as CHAT_MODEL (no tiering)
LIGHT_MODEL=huihui_ai/gemma-4-abliterated:e4b

# Embedding model
EMBEDDING_MODEL=mxbai-embed-large

# ─── Legacy (still read as fallback) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=3001
DATABASE_PATH=./data/little-life.db
