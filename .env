# ─── LLM Configuration ───────────────────────────────────────────────────────
# Backend: "ollama" (default) or "openai" (llama-server, vLLM, LM Studio)
LLM_BACKEND=ollama

# Base URL for chat models
# For Ollama: http://localhost:11434
# For llama-server: http://localhost:8080
LLM_BASE_URL=http://localhost:11434

# Separate base URL for embeddings (always uses Ollama API)
EMBED_BASE_URL=http://localhost:11434

# Heavy model — conversations, reflections, snap resolution.
# Gemma 4 26B-A4B (MoE, ~4B active): as fast as the old e4b on a 3090 (~110 tok/s,
# ~200 aggregate with 4 slots) and far better in character. Stays in character in
# dark scenes, so no abliterated build is needed (those glitch: stray tokens,
# doubled words). Chosen with scripts/llm-bench.ts on 2026-09-29.
CHAT_MODEL=gemma4:26b-a4b-it-mtp-q4_K_M

# Light model — planning, decomposition, goals, self-descriptions.
# Keep it the same as CHAT_MODEL on a single 24 GB GPU: two different models do
# not fit together and Ollama would swap them on every call.
LIGHT_MODEL=gemma4:26b-a4b-it-mtp-q4_K_M

# Chat requests in flight at once. Must match OLLAMA_NUM_PARALLEL (start-game.bat).
LLM_PARALLEL=4

# Embedding model
EMBEDDING_MODEL=mxbai-embed-large

# ─── Legacy (still read as fallback) ─────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=3001
DATABASE_PATH=./data/little-life.db
